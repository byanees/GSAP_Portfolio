{
  "redirects": [
    { "source": "/index-16", "destination": "/", "permanent": true },
    { "source": "/about-3", "destination": "/about", "permanent": true },
    { "source": "/services-2", "destination": "/about", "permanent": true },
    { "source": "/services", "destination": "/about", "permanent": true },
    { "source": "/portfolio-3", "destination": "/portfolio", "permanent": true },
    { "source": "/portfolio-details-3", "destination": "/portfolio", "permanent": true },
    { "source": "/portfolio-details-3/:slug", "destination": "/portfolio/:slug", "permanent": true },
    { "source": "/archive-4", "destination": "/blog", "permanent": true },
    { "source": "/blog-details", "destination": "/blog", "permanent": true },
    { "source": "/blog-details/:slug", "destination": "/blog/:slug", "permanent": true },
    { "source": "/contact-2", "destination": "/contact", "permanent": true },
    { "source": "/portfolio/emv-qr-request-to-pay", "destination": "/portfolio/request-to-pay", "permanent": true },
    { "source": "/portfolio/telecom-agent-apps", "destination": "/portfolio#projects", "permanent": true },
    { "source": "/feed", "destination": "/rss.xml", "permanent": true },
    { "source": "/feed.xml", "destination": "/rss.xml", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/:file([^/]+\\.(?:js|css))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    },
    {
      "source": "/:name(llms|llms-full).txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/indexnow.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/rss.xml",
      "headers": [{ "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" }]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false
}
